{
  "name": "gamesavecloud",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --import tsx --test \"packages/**/*.test.ts\" \"src/**/*.test.ts\" \"src/**/*.test.tsx\" \"app/**/*.test.ts\" \"app/**/*.test.tsx\" \"apps/**/src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "desktop": "pnpm -F @gsc/desktop dev",
    "desktop:build": "pnpm -F @gsc/desktop build",
    "desktop:dist": "pnpm -F @gsc/desktop dist",
    "gc": "curl -s -X POST -H \"authorization: Bearer $GAMESYNC_TOKEN\" $GSC_SERVER/api/v1/gc",
    "release": "tsx scripts/publish-release.ts",
    "ship": "tsx scripts/ship.ts",
    "ship:watch": "gh run watch $(gh run list --limit 1 --json databaseId --jq '.[0].databaseId') --exit-status",
    "ship:local": "pnpm desktop:dist && pnpm release"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@gsc/shared": "workspace:*",
    "@gsc/recipes": "workspace:*",
    "@neondatabase/serverless": "^0.10.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.14",
    "lucide-react": "^0.469.0",
    "next": "^15.1.3",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1",
    "@aws-sdk/lib-storage": "^3.700.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
