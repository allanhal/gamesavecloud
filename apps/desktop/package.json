{
  "name": "@gsc/desktop",
  "version": "0.4.12",
  "private": true,
  "description": "gamesavecloud — cloud saves for PC games",
  "author": "gamesavecloud",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --import tsx --test \"packages/**/*.test.ts\" \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
