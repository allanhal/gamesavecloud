{
  "name": "@gsc/desktop",
  "version": "0.2.1",
  "private": true,
  "description": "gamesavecloud \u2014 cloud saves for PC games",
  "author": "gamesavecloud",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && electron .",
    "dist": "node build.mjs && electron-builder --win",
    "dist:dir": "node build.mjs && electron-builder --win --dir",
    "dist:portable": "node build.mjs && electron-builder --win --config electron-builder.portable.yml",
    "dist:all": "pnpm dist && pnpm dist:portable"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@gsc/core": "workspace:*",
    "@gsc/recipes": "workspace:*",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "build": {
    "appId": "dev.gamesavecloud.desktop",
    "productName": "gamesavecloud",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/semver/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/universalify/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/debug/**/*",
      "node_modules/ms/**/*",
      "node_modules/argparse/**/*",
      "node_modules/sax/**/*",
      "node_modules/tiny-typed-emitter/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "gamesavecloud-${version}-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "gamesavecloud"
    },
    "compression": "normal",
    "publish": [
      {
        "provider": "generic",
        "url": "https://gamesavecloud.vercel.app/updates/win",
        "channel": "latest"
      }
    ]
  }
}