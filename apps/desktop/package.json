{
  "name": "@gsc/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "gamesavecloud \u2014 cloud saves for PC games",
  "author": "gamesavecloud",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && electron .",
    "dist": "node build.mjs && electron-builder --win",
    "dist:dir": "node build.mjs && electron-builder --win --dir"
  },
  "dependencies": {},
  "devDependencies": {
    "@gsc/core": "workspace:*",
    "@gsc/recipes": "workspace:*",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "build": {
    "appId": "dev.gamesavecloud.desktop",
    "productName": "gamesavecloud",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "gamesavecloud-${version}-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "gamesavecloud"
    },
    "compression": "maximum"
  }
}