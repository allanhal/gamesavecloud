{
  "name": "@gsc/desktop",
  "version": "0.4.12",
  "private": true,
  "description": "gamesavecloud — cloud saves for PC via R2 central storage",
  "author": "Allan Pinheiro <allan.hal@gmail.com>",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs && electron-builder -c.electron.dist=dist --win portable,exe",
    "dist": "electron-builder --dir --win portable,exe",  
    "test": "tsx src/server/migrate.ts && pnpm exec tsx --test \"packages/**/*.test.ts\"",
    "release": "tsx scripts/publish-release.ts"
  },
  "dependencies": {
    "@gsc/core": "workspace:*",
    "@gsc/recipes": "workspace:*"
  },
  "devDependencies": {
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "@types/node": "*"
  }
}
